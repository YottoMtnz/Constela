{
  "name": "constela-desktop",
  "productName": "Constela",
  "version": "1.0.0",
  "description": "Constela: muchas IA, ninguna clave.",
  "author": "Constela",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.constela.app",
    "productName": "Constela",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "icon.png", "app/**/*"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Constela",
      "artifactName": "Constela-Setup-${version}.exe"
    },
    "portable": { "artifactName": "Constela-Portable-${version}.exe" }
  }
}
